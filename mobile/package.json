{
  "name": "tabby-android-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "tsc --noEmit -p web/tsconfig.json",
    "test:web": "playwright test --config web/playwright.config.ts",
    "test:fixture": "node --test test/ssh-fixture.test.mjs",
    "test:delivery": "python3 -m unittest discover -s test -p test_android_delivery.py -v",
    "test:native": "node scripts/test-fixture-native.mjs",
    "sync:android": "cap sync android"
  },
  "dependencies": {
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/platform-browser": "15.2.10",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "ssh2": "1.17.0",
    "typescript": "4.9.5",
    "vite": "5.4.21"
  }
}
