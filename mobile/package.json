{
  "name": "tabby-android-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve-web.mjs --test-harness",
    "build": "ng build mobile --configuration production && node scripts/verify-web-build.mjs --fresh",
    "check": "ngc --noEmit -p web/tsconfig.app.json && tsc --noEmit -p web/tsconfig.tests.json && node --test test/android-acceptance-static.test.mjs",
    "test:build": "node scripts/verify-web-build.mjs",
    "test:toolchain": "node scripts/verify-capacitor-toolchain.mjs",
    "test:web": "playwright test --config web/playwright.config.ts",
    "test:tmux-controller": "node --test test/tmux-controller.test.mjs",
    "test:tmux-fixture": "node --test test/ssh-control-fixture.test.mjs test/ssh-tmux-fixture.test.mjs",
    "test:fixture": "node --test test/ssh-fixture.test.mjs",
    "test:delivery": "python3 -m unittest discover -s test -p test_android_delivery.py -v",
    "test:native": "node scripts/test-fixture-native.mjs",
    "sync:android": "cap sync android"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "ssh2": "1.17.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@capacitor/cli": {
      "xcode@3.0.1": { "uuid": "11.1.1" }
    }
  }
}
